# Copy to frontend/.env.local for local dev (never commit real values).
# In production, set these in Vercel → Settings → Environment Variables.
# Supabase project → Project Settings → API. Leave the three Supabase lines empty locally to
# use the in-memory poll.
SUPABASE_URL=https://your-project-ref.supabase.co
# Newer dashboards call this the "publishable" key. Public by design (RLS protects the data).
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Newer dashboards call this the "secret" key. Server only: never add a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Protects the dashboard's reset / reseed buttons.
ADMIN_PASSCODE=choose-a-long-passcode
